{
  "name": "rhymescape",
  "private": true,
  "version": "0.0.0",
  "description": "Rhymescape: a bars-and-flow lyric tool. Currently: design direction and style tile only.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "fonts": "node scripts/copy-fonts.mjs",
    "tile": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
